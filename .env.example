# Besinsky Bot — Environment Variables
# Copy this file to .env and fill in your values

# The name of the WhatsApp group that receives bot digests and confirmations
MASTER_GROUP_NAME=Besinsky Family

# Google Calendar IDs (use "primary" for the main calendar, or get from Google Calendar settings)
AVIV_CALENDAR_ID=primary
LIAT_CALENDAR_ID=primary

# Paths to Google OAuth credentials and tokens
GOOGLE_CREDENTIALS_PATH=./credentials.json
AVIV_TOKEN_PATH=./token-aviv.json
LIAT_TOKEN_PATH=./token-liat.json

# Timezone for scheduling and date formatting
TIMEZONE=Asia/Jerusalem
