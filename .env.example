# Family Bot — Environment Variables
# Copy this file to .env and fill in your values

# ── Required: Parent phones (E.164 without +, e.g. 12125551234) ─────────────
AVIV_PHONE=YOUR_PRIMARY_PARENT_PHONE
LIAT_PHONE=YOUR_SECONDARY_PARENT_PHONE

# ── Required: Master WhatsApp group (exact group name) ──────────────────────
MASTER_GROUP_NAME=Your Family Tasks Group
MASTER_GROUP_JID=YOUR_GROUP_JID@g.us

# ── Required: Google Calendar IDs ───────────────────────────────────────────
AVIV_CALENDAR_ID=parent1@gmail.com
LIAT_CALENDAR_ID=parent2@gmail.com
LIAT_WORK_CALENDAR_ID=

# ── Required: API Keys ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional: Paths ───────────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_PATH=./credentials.json
AVIV_TOKEN_PATH=./token-aviv.json
LIAT_TOKEN_PATH=./token-liat.json
TIMEZONE=UTC
CHROMIUM_PATH=/usr/bin/chromium-browser

# ── Optional: Bot identity ────────────────────────────────────────────────────
BOT_NAME=FamilyBot
BOT_NAME_ALT=familybot

# ── Feature flags (1=on, 0=off) ───────────────────────────────────────────────
FEAT_CONV_HISTORY=1
FEAT_MEMBER_RES=1
FEAT_CONFIRM=1
FEAT_CLARIFY=1
